__pycache__/
*.pyc
raw/
out/

# Credenciales de servicio: dan acceso total al proyecto, saltándose
# las reglas de Firestore. Nunca al repositorio.
serviceAccount.json
firebase/serviceAccount.json
*-firebase-adminsdk-*.json
.env
.env.local

node_modules/
package-lock.json

# Derivado de datos/*.csv — se regenera con: python3 firebase/transformar.py
firebase/data/
.firebase/
firebase-debug.log

# PDFs descargados de MINEDUC — se vuelven a bajar solos
.cache-pdf/

# Datos de contacto masivos: el repo es público y estos archivos traen
# miles de correos personales y nombres de personas. Van a Firestore,
# que está protegido por reglas, no a GitHub.
# Patrón amplio a propósito: el archivo descargado puede llegar con
# guiones, sin guiones o con "(1)" según el navegador, y un nombre que
# no calce publica miles de correos personales en un repo público.
datos/*ontact*.csv
datos/*correo*.csv
!datos/contactos-verificados.csv

# Descargas del Simce: se vuelven a bajar solas
.cache-simce/

functions/node_modules/
